{
  "schemaVersion": 1,
  "productName": "Gomi IDE",
  "description": "Code - OSS integration manifest for Gomi Office IDE.",
  "productJson": {
    "source": "product.json",
    "target": "product.json",
    "mode": "merge",
    "removeKeys": [
      "builtInExtensions",
      "builtInExtensionsEnabledWithAutoUpdates",
      "defaultChatAgent",
      "trustedExtensionAuthAccess",
      "webviewContentExternalBaseUrlTemplate",
      "onboardingKeymaps",
      "onboardingThemes",
      "sessionsWindowAllowedExtensions"
    ]
  },
  "moduleCopies": [
    {
      "source": "src/vs/workbench/contrib/gomi",
      "target": "src/vs/workbench/contrib/gomi"
    }
  ],
  "templateCopies": [
    {
      "source": "build/code-oss-templates/gomiContribution.ts",
      "target": "src/vs/workbench/contrib/gomi/browser/gomiContribution.ts"
    }
  ],
  "webviewAssetCopies": [
    {
      "source": "build/gomi-office-webview",
      "target": "src/vs/workbench/contrib/gomi/browser/media/office"
    }
  ],
  "resourceCopies": [
    {
      "source": "resources/gomi-icon.svg",
      "target": "resources/gomi-icon.svg"
    },
    {
      "source": "resources/gomi-branding/win32/gomi.ico",
      "target": "resources/win32/code.ico"
    },
    {
      "source": "resources/gomi-branding/win32/gomi_70x70.png",
      "target": "resources/win32/code_70x70.png"
    },
    {
      "source": "resources/gomi-branding/win32/gomi_150x150.png",
      "target": "resources/win32/code_150x150.png"
    },
    {
      "source": "resources/gomi-branding/win32/inno-big-100.bmp",
      "target": "resources/win32/inno-big-100.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-big-125.bmp",
      "target": "resources/win32/inno-big-125.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-big-150.bmp",
      "target": "resources/win32/inno-big-150.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-big-175.bmp",
      "target": "resources/win32/inno-big-175.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-big-200.bmp",
      "target": "resources/win32/inno-big-200.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-big-225.bmp",
      "target": "resources/win32/inno-big-225.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-big-250.bmp",
      "target": "resources/win32/inno-big-250.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-small-100.bmp",
      "target": "resources/win32/inno-small-100.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-small-125.bmp",
      "target": "resources/win32/inno-small-125.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-small-150.bmp",
      "target": "resources/win32/inno-small-150.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-small-175.bmp",
      "target": "resources/win32/inno-small-175.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-small-200.bmp",
      "target": "resources/win32/inno-small-200.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-small-225.bmp",
      "target": "resources/win32/inno-small-225.bmp"
    },
    {
      "source": "resources/gomi-branding/win32/inno-small-250.bmp",
      "target": "resources/win32/inno-small-250.bmp"
    },
    {
      "source": "resources/gomi-branding/linux/gomi.png",
      "target": "resources/linux/code.png"
    },
    {
      "source": "resources/gomi-branding/darwin/gomi.icns",
      "target": "resources/darwin/code.icns"
    }
  ],
  "workbenchImports": [
    {
      "target": "src/vs/workbench/workbench.common.main.ts",
      "import": "import 'vs/workbench/contrib/gomi/browser/gomiContribution';"
    }
  ],
  "activityBar": {
    "viewContainerId": "workbench.view.gomiOffice",
    "viewId": "gomi.office.view",
    "title": "Gomi Office",
    "command": "gomi.openOffice"
  },
  "commands": [
    "gomi.openOffice",
    "gomi.runAgentTask",
    "gomi.stopAgentTask"
  ]
}
